# Frontend build settings. Copy to frontend/.env (git-ignored). Not secret: Vite puts
# every VITE_ value into the built app.

# Where the API lives. Leave unset for the browser: npm run dev proxies /api to Django.
# The installed app needs it. For the iOS simulator and the Android emulator use
# http://127.0.0.1:8000; on Android also run `adb reverse tcp:8000 tcp:8000` so the
# emulator's 127.0.0.1:8000 reaches Django on this Mac.
# VITE_API_BASE_URL=http://127.0.0.1:8000
