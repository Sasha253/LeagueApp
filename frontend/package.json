{
  "name": "leagueapp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "node scripts/gen-api.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run build && cap run ios",
    "cap:android": "npm run build && cap run android",
    "assets": "node scripts/app-assets.mjs",
    "version:apply": "node scripts/app-version.mjs apply",
    "version:bump": "node scripts/app-version.mjs bump",
    "version:set": "node scripts/app-version.mjs set"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
