# Production settings for the VM. Copy to <VM_APP_DIR>/.env on the VM (never commit it);
# each deploy links it next to docker-compose.prod.yml. See docs/DEPLOY.md.

# The domain Caddy serves and gets the HTTPS certificate for (its DNS points at the VM).
SITE_DOMAIN=league.example.com

# Django
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=league.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://league.example.com
# The installed app's origins (capacitor://localhost, https://localhost) are always allowed.
CORS_ALLOWED_ORIGINS=

# PostgreSQL, on the VM in docker compose. Use a URL-safe password (letters and digits):
# docker-compose.prod.yml puts it into DATABASE_URL.
POSTGRES_DB=leagueapp
POSTGRES_USER=leagueapp
POSTGRES_PASSWORD=

# Push notifications through Firebase: the service account JSON on one line.
PUSH_SENDER=notifications.push.FirebaseSender
FIREBASE_CREDENTIALS_JSON=

# PayFast, live. PAYFAST_CLUB_ACCOUNTS gives a Club its own merchant account (.env.example).
PAYFAST_SANDBOX=false
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_CLUB_ACCOUNTS={}
PAYFAST_NOTIFY_URL=https://league.example.com/api/v1/payments/payfast/notify/
PAYMENT_RETURN_URL=https://league.example.com/payments/done
PAYMENT_CANCEL_URL=https://league.example.com/payments/cancelled
# Caddy is the one proxy in front of Django.
PAYFAST_TRUSTED_PROXIES=1

# Payment Barcodes: a long random key of their own (required in production).
BARCODE_SIGNING_KEY=

# The privacy policy page (/privacy/).
PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=
