# Local development settings. Copy to .env (git-ignored) and change the secrets.
# Real environment variables always take precedence over .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (docker compose, make up). Port 5433 so it can run beside Swingbok's 5432.
POSTGRES_DB=leagueapp
POSTGRES_USER=leagueapp
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
DATABASE_URL=postgres://leagueapp:change-me@127.0.0.1:5433/leagueapp

# Redis (docker compose, make up), the Celery broker for the timed checkpoints (make worker,
# make beat). Port 6380 so it can run beside Swingbok's 6379.
REDIS_PORT=6380
CELERY_BROKER_URL=redis://127.0.0.1:6380/0

# The Vite dev server proxies /api to Django, so CORS is only needed for other origins.
# The installed app's origins (capacitor://localhost, https://localhost) are always allowed.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Push notifications. Locally they are only logged (notifications.push.LogSender).
# To send real pushes, set PUSH_SENDER=notifications.push.FirebaseSender and point
# FIREBASE_CREDENTIALS_FILE at a Firebase service account JSON file (never commit it),
# or put the JSON itself in FIREBASE_CREDENTIALS_JSON.
PUSH_SENDER=notifications.push.LogSender
FIREBASE_CREDENTIALS_FILE=

# Card payments through PayFast (payments/). Locally the sandbox: these are PayFast's
# public sandbox test credentials (https://sandbox.payfast.co.za); use your own sandbox
# merchant to see ITNs. Production sets PAYFAST_SANDBOX=false and the club's live keys.
# PAYFAST_CLUB_ACCOUNTS (optional) gives a Club its own merchant account, keyed by Club id:
# {"12": {"merchant_id": "...", "merchant_key": "...", "passphrase": "..."}}
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=
PAYFAST_CLUB_ACCOUNTS={}
# PayFast must reach the ITN URL over the internet (a tunnel such as ngrok locally).
PAYFAST_NOTIFY_URL=https://example.ngrok.app/api/v1/payments/payfast/notify/
# The app's result screens (frontend routes); PayFast adds nothing, we add ?payment=<reference>.
PAYMENT_RETURN_URL=http://localhost:5173/payments/done
PAYMENT_CANCEL_URL=http://localhost:5173/payments/cancelled
# How many reverse proxies add to X-Forwarded-For in front of Django (0: none).
PAYFAST_TRUSTED_PROXIES=0

# Payment Barcodes (barcodes/): the key that signs every Barcode code. Use a long random
# value in production. Empty uses a key derived from DJANGO_SECRET_KEY.
BARCODE_SIGNING_KEY=
# Gate scans each signed-in Admin or Referee may make per minute (barcodes/ ScanView).
BARCODE_SCAN_THROTTLE_RATE=60/min

# The privacy policy page (/privacy/, linked from the App Store and Google Play listings):
# the business that runs League App and the address for privacy questions and requests.
PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=

# Email: invites to join a Team for people not in League App yet (teams/rules.py). Empty
# prints them to the console. Production: smtp+tls://user:password@smtp.example.com:587
EMAIL_URL=
DEFAULT_FROM_EMAIL=League App <no-reply@localhost>
# The app's sign-up screen, linked from those emails.
APP_SIGNUP_URL=http://localhost:5173/signup
